<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Política SL1</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f6f8;
      color: #222;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .contenedor {
      width: 100%;
      max-width: 420px;
      min-height: 650px;
      background: white;
      padding: 50px 30px 25px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: center;
      box-shadow: 0 5px 25px rgba(0,0,0,0.08);
      border-radius: 12px;
    }

    h1 {
      font-size: 30px;
      margin-bottom: 45px;
    }

    .botones {
      display: flex;
      flex-direction: column;
      gap: 15px;
      align-items: center;
    }

    button {
      width: 220px;
      padding: 14px;
      border: none;
      border-radius: 8px;
      background: #111827;
      color: white;
      font-size: 16px;
      cursor: pointer;
      transition: 0.2s;
    }

    button:hover {
      background: #374151;
      transform: translateY(-1px);
    }

    .enlaces {
      font-size: 14px;
      line-height: 1.8;
    }

    .enlaces a {
      color: #374151;
      text-decoration: none;
    }

    .enlaces a:hover {
      text-decoration: underline;
    }

    .separador {
      margin: 0 8px;
      color: #aaa;
    }

    /* Ventana emergente */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal.activo {
      display: flex;
    }

    .modal-contenido {
      width: 100%;
      max-width: 380px;
      background: white;
      padding: 30px;
      border-radius: 12px;
      text-align: left;
      position: relative;
    }

    .modal-contenido h2 {
      margin-bottom: 20px;
      text-align: center;
    }

    .modal-contenido input {
      width: 100%;
      padding: 12px;
      margin-bottom: 12px;
      border: 1px solid #ccc;
      border-radius: 7px;
      font-size: 15px;
    }

    .modal-contenido .enviar {
      width: 100%;
      margin-top: 5px;
    }

    .cerrar {
      position: absolute;
      right: 15px;
      top: 10px;
      width: auto;
      padding: 5px 10px;
      background: transparent;
      color: #555;
      font-size: 22px;
    }

    .texto-legal {
      max-height: 300px;
      overflow-y: auto;
      font-size: 14px;
      line-height: 1.6;
      color: #444;
    }
  </style>
</head>

<body>

  <main class="contenedor">

    <section>
      <h1>Política SL1</h1>

      <div class="botones">
        <button onclick="abrirModal('login')">
          Iniciar sesión
        </button>

        <button onclick="abrirModal('registro')">
          Registrarme
        </button>
      </div>
    </section>

    <footer class="enlaces">
      <a href="#" onclick="abrirModal('privacidad'); return false;">
        Política de privacidad
      </a>

      <span class="separador">|</span>

      <a href="#" onclick="abrirModal('terminos'); return false;">
        Términos y condiciones
      </a>
    </footer>

  </main>


  <!-- INICIAR SESIÓN -->
  <div id="login" class="modal">
    <div class="modal-contenido">
      <button class="cerrar" onclick="cerrarModales()">×</button>

      <h2>Iniciar sesión</h2>

      <form onsubmit="iniciarSesion(event)">
        <input
          type="email"
          placeholder="Correo electrónico"
          required
        >

        <input
          type="password"
          placeholder="Contraseña"
          required
        >

        <button class="enviar" type="submit">
          Entrar
        </button>
      </form>
    </div>
  </div>


  <!-- REGISTRO -->
  <div id="registro" class="modal">
    <div class="modal-contenido">
      <button class="cerrar" onclick="cerrarModales()">×</button>

      <h2>Crear cuenta</h2>

      <form onsubmit="registrarse(event)">
        <input
          type="text"
          placeholder="Nombre completo"
          required
        >

        <input
          type="email"
          placeholder="Correo electrónico"
          required
        >

        <input
          type="password"
          placeholder="Contraseña"
          required
        >

        <button class="enviar" type="submit">
          Registrarme
        </button>
      </form>
    </div>
  </div>


  <!-- PRIVACIDAD -->
  <div id="privacidad" class="modal">
    <div class="modal-contenido">
      <button class="cerrar" onclick="cerrarModales()">×</button>

      <h2>Política de privacidad</h2>

      <div class="texto-legal">
        <p>
          Tu privacidad es importante para nosotros.
          Esta sección contiene información sobre el tratamiento
          y protección de los datos personales de los usuarios.
        </p>

        <br>

        <p>
          Los datos proporcionados por el usuario serán utilizados
          únicamente para las funciones relacionadas con el servicio.
        </p>
      </div>
    </div>
  </div>


  <!-- TÉRMINOS -->
  <div id="terminos" class="modal">
    <div class="modal-contenido">
      <button class="cerrar" onclick="cerrarModales()">×</button>

      <h2>Términos y condiciones</h2>

      <div class="texto-legal">
        <p>
          Al utilizar Política SL1 aceptas los términos y condiciones
          establecidos para el uso de la plataforma.
        </p>

        <br>

        <p>
          El usuario se compromete a utilizar el servicio de forma
          responsable y conforme a la legislación aplicable.
        </p>
      </div>
    </div>
  </div>


  <script>
    function abrirModal(id) {
      cerrarModales();
      document.getElementById(id).classList.add("activo");
    }

    function cerrarModales() {
      document.querySelectorAll(".modal").forEach(modal => {
        modal.classList.remove("activo");
      });
    }

    function iniciarSesion(event) {
      event.preventDefault();
      alert("Inicio de sesión enviado.");
    }

    function registrarse(event) {
      event.preventDefault();
      alert("Registro enviado correctamente.");
    }

    // Cerrar al hacer clic fuera de la ventana
    document.querySelectorAll(".modal").forEach(modal => {
      modal.addEventListener("click", function(event) {
        if (event.target === modal) {
          cerrarModales();
        }
      });
    });
  </script>

</body>
</html>
